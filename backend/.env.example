# ---- SteelBid backend environment (example — never commit real secrets) ----
# Database
DATABASE_URL=postgresql+psycopg://steelbid:CHANGE_ME@127.0.0.1:5432/steelbid

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0

# Security — generate a long random value in production
SECRET_KEY=CHANGE_ME_LONG_RANDOM
COOKIE_SECURE=false          # true in production (HTTPS)
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://127.0.0.1:5173

# Demo seeding (development only — seeds NEVER run automatically in production)
DEMO_ADMIN_PASSWORD=CHANGE_ME
DEMO_MODE=false
CELERY_ALWAYS_EAGER=false

# Storage — local dir or S3-compatible endpoint
UPLOAD_DIR=./data/uploads
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Pluggable LLM provider: stub (deterministic, default) | anthropic | openai
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=
